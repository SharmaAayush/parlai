# Database connection URL (PostgreSQL)
# In production, this is constructed from POSTGRES_PASSWORD in docker-compose.prod.yml
# DATABASE_URL=postgres://parlai:${POSTGRES_PASSWORD}@db:5432/parlai

# Application URL (used for CORS, redirects, etc.)
APP_URL=https://your-domain.com

# Node environment
NODE_ENV=production

# PostgreSQL password (required for production)
POSTGRES_PASSWORD=your-secure-password-here

# Domain for Caddy reverse proxy (required for production with proxy profile)
DOMAIN=your-domain.com

# Docker image to use (optional, defaults to parl-ai:local)
# PARLAI_IMAGE=ghcr.io/your-org/parl-ai:v0.1.0

# Trust proxy headers (required when behind Caddy/NGINX)
TRUST_PROXY=true