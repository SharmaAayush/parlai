# Database connection URL (PostgreSQL)
# In production, this is constructed from POSTGRES_PASSWORD in docker-compose.prod.yml
# DATABASE_URL=postgres://parlai:${POSTGRES_PASSWORD}@db:5432/parlai

# Application URL (used for CORS, redirects, etc.)
APP_URL=https://your-domain.com

# Node environment
NODE_ENV=production

# PostgreSQL password (required for production)
POSTGRES_PASSWORD=your-secure-password-here

# Domain for Caddy reverse proxy (required for production with proxy profile)
DOMAIN=your-domain.com

# Docker image to use (optional, defaults to parl-ai:local)
# PARLAI_IMAGE=ghcr.io/your-org/parl-ai:v0.1.0

# Trust proxy headers (required when behind Caddy/NGINX)
TRUST_PROXY=true

# Provider configuration (S1.1)
# Comma-separated list of supported provider ids
SUPPORTED_PROVIDERS=openrouter,local

# OpenRouter provider
PROVIDER_OPENROUTER_LABEL=OpenRouter
PROVIDER_OPENROUTER_TYPE=openai-compatible
PROVIDER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PROVIDER_OPENROUTER_API_KEY=sk-...

# Local (Ollama) provider
PROVIDER_LOCAL_LABEL=Local (Ollama)
PROVIDER_LOCAL_TYPE=openai-compatible
PROVIDER_LOCAL_BASE_URL=http://localhost:11434/v1
PROVIDER_LOCAL_REQUIRES_KEY=false

# Allowed models (providerId:modelId, comma-separated)
ALLOWED_MODELS=openrouter:vendor/model-a,local:llama3.1:8b

# Default provider and model (must form an entry in ALLOWED_MODELS)
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=vendor/model-a